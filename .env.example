# ═══════════════════════════════════════════════════════════
#  Universal Session Bot — Environment Variables
#  Author  : Sakil (@YO_UR_OFFICIAL_CRUSH)
#  Telegram: https://t.me/YO_UR_OFFICIAL_CRUSH
#  GitHub  : https://github.com/SakilSakil699
#
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to Git.
# ═══════════════════════════════════════════════════════════

# ── Telegram API (from https://my.telegram.org) ──
API_ID=1234567
API_HASH=your_api_hash_here_32_chars

# ── Bot Token (from @BotFather) ──
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ── Owner & Admins ──
# Get your ID from @userinfobot
OWNER_ID=123456789
# Comma-separated list of admin IDs
ADMIN_IDS=

# ── Encryption (generate with: python scripts/generate_key.py) ──
ENCRYPTION_KEY=generate_a_64_char_hex_string_here_replace_me_please

# ── Database ──
# PostgreSQL (production):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sessionbot
# SQLite (dev):
# DATABASE_URL=sqlite+aiosqlite:///./data/sessions.db

# ── Redis (optional, for caching) ──
REDIS_URL=redis://localhost:6379/0

# ── Rate Limiting ──
RATE_LIMIT_PER_MINUTE=5
MAX_SESSIONS_PER_USER=10

# ── Feature Flags ──
ENABLE_FEROGRAM=false
ENABLE_GRAMJS=false
ENABLE_TDATA=false

# ── Logging ──
LOG_LEVEL=INFO

# ── API Dashboard (optional) ──
API_HOST=0.0.0.0
API_PORT=8000
