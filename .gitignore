# ─────────────────────────────────────────────────────────
#  🔐 SECRETS (NEVER commit — highest priority)
# ─────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# Telegram sessions (plaintext)
*.session
*.session-journal
*.session.backup

# Auth keys / sensitive output
auth_key.txt
auth_keys/
*.auth

# Encryption keys
*.key
encryption.key


# ─────────────────────────────────────────────────────────
#  🐍 Python
# ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv/
.conda/

# PyInstaller
*.manifest
*.spec

# Unit test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/


# ─────────────────────────────────────────────────────────
#  📦 Vendors (cloned via scripts/setup_vendors.sh)
# ─────────────────────────────────────────────────────────
vendors/tgconvert/*
vendors/AndroidTelePorter/*
vendors/tdata_reader/*

# Keep placeholders (so folders exist in repo)
!vendors/tgconvert/.gitkeep
!vendors/AndroidTelePorter/.gitkeep
!vendors/tdata_reader/.gitkeep
!vendors/__init__.py
!vendors/README.md
!vendors/.gitkeep


# ─────────────────────────────────────────────────────────
#  🗄️  Runtime Data (do not commit)
# ─────────────────────────────────────────────────────────
data/
!data/.gitkeep

data/sessions/
data/tdata/
data/tgnet/
data/*.db
data/*.sqlite
data/*.sqlite3

# Logs
logs/
!logs/.gitkeep
*.log
*.log.*


# ─────────────────────────────────────────────────────────
#  🌐 Node.js (for GramJS worker)
# ─────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
.pnpm-debug.log*

# Keep GramJS package.json
!engines/gramjs_package.json


# ─────────────────────────────────────────────────────────
#  💻 IDE / Editor
# ─────────────────────────────────────────────────────────
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/


# ─────────────────────────────────────────────────────────
#  🖥️  OS-specific
# ─────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini


# ─────────────────────────────────────────────────────────
#  🐳 Docker
# ─────────────────────────────────────────────────────────
.dockerignore.local
docker-compose.override.yml


# ─────────────────────────────────────────────────────────
#  ☁️  Deployment / CI
# ─────────────────────────────────────────────────────────
*.pem
*.crt
*.cer
deploy/
deployment/
.github/workflows/*.local.yml


# ─────────────────────────────────────────────────────────
#  🧪 Test artifacts
# ─────────────────────────────────────────────────────────
.pytest_cache/
.hypothesis/
*.cover
.coverage
coverage.xml
.tox/


# ─────────────────────────────────────────────────────────
#  📊 Database dumps
# ─────────────────────────────────────────────────────────
*.sql
*.dump
*.bak
pgdata/


# ─────────────────────────────────────────────────────────
#  🔧 Misc
# ─────────────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.old
*.orig
*.rej
tmp/
temp/
.cache/


